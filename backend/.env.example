# Application Environment
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# Security & Encryption (AES-256-GCM for DKIM Private Keys)
JWT_SECRET=replace_with_a_secure_random_256_bit_secret
DB_ENCRYPTION_KEY=replace_with_a_secure_32_byte_aes_key

# PostgreSQL Database (Host port mapped to 5433 in local Docker)
DATABASE_URL="postgresql://dispatchhub_user:dispatchhub_secure_pass_2026@localhost:5433/dispatchhub?schema=public"

# Redis Shard Queue (Shards 0..3 & Priority Bypass)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Postal MTA Server Integration (Self-Hosted on OVH / Cloud)
POSTAL_HOST=http://postal.yourdomain.com:5000
POSTAL_API_KEY=your_postal_server_api_key
POSTAL_SPF_INCLUDE=spf.postal.yourdomain.com
