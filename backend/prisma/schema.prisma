datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CLIENT
}

enum DomainStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum BrandingMode {
  WHITE_LABEL // 100% Customer Brand or Clean (Full Rate)
  CO_BRANDED  // Includes "Powered by DispatchHub" footer badge (Discounted Rate)
}

enum BrandType {
  NONE           // Clean, no footer
  CUSTOMER_BRAND // Customer's own company signature/footer (White-Label only)
  PLATFORM_BRAND // DispatchHub co-branded watermark (Discounted tier)
}

enum EmailCategory {
  TRANSACTIONAL // White-Label: $0.050 | Co-Branded: $0.025
  MARKETING     // White-Label: $0.035 | Co-Branded: $0.015
  NOTIFICATION  // White-Label: $0.025 | Co-Branded: $0.010
  TEST          // White-Label: $0.010 | Co-Branded: $0.010
}

enum ApprovalStatus {
  AUTO_APPROVED
  PENDING_ADMIN_APPROVAL
  REJECTED
}

enum MessageStatus {
  PENDING
  IN_FLIGHT
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  QUEUED
  PROCESSING
  COMPLETED
  PAUSED
  FAILED
  REJECTED
}

enum TransactionType {
  ADMIN_TOPUP
  DEBIT_SEND
  REFUND
}

model Account {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  apiKey             String              @unique @default(uuid())
  role               Role                @default(CLIENT)
  isActive           Boolean             @default(true)
  isTrusted          Boolean             @default(false)
  wallet             Wallet?
  domains            Domain[]
  templates          Template[]
  campaigns          Campaign[]
  messages           Message[]
  walletTransactions WalletTransaction[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("accounts")
}

model Wallet {
  id           String              @id @default(uuid())
  accountId    String              @unique
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0.00) @db.Decimal(12, 4)
  currency     String              @default("USD")
  isLocked     Boolean             @default(false)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id            String          @id @default(uuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount        Decimal         @db.Decimal(12, 4) // Negative for debits, positive for credits
  balanceBefore Decimal         @db.Decimal(12, 4)
  balanceAfter  Decimal         @db.Decimal(12, 4)
  type          TransactionType
  description   String
  referenceId   String?         // Campaign ID, Message ID, or Invoice ID
  performedBy   String          // "ADMIN: admin@dispatchhub.com" or "SYSTEM"
  schemaVersion String          @default("1.0.0")
  createdAt     DateTime        @default(now())

  @@index([accountId, createdAt(sort: Desc)])
  @@index([referenceId])
  @@map("wallet_transactions")
}

model Domain {
  id             String               @id @default(uuid())
  accountId      String
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  domainName     String
  dkimSelector   String               @default("postal")
  dkimPublicKey  String               @db.Text
  dkimPrivateKey String               @db.Text
  spfRecord      String               @default("v=spf1 a mx ip4:148.113.44.84 include:spf.postal.sudhi.online ~all")
  isSpfVerified  Boolean              @default(false)
  isDkimVerified Boolean              @default(false)
  isMxVerified   Boolean              @default(false)
  status         DomainStatus         @default(PENDING_VERIFICATION)
  campaigns      Campaign[]
  messages       Message[]
  verifications  DomainVerification[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([accountId, domainName])
  @@index([accountId, status])
  @@map("domains")
}

model Template {
  id           String        @id @default(uuid())
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  category     EmailCategory @default(TRANSACTIONAL)
  subject      String
  htmlContent  String        @db.Text
  plainContent String?       @db.Text
  brandType    BrandType     @default(NONE)
  footerHtml   String?       @db.Text // Exact rendered footer (Customer or Platform)
  variables    Json?         // e.g. ["header.name", "body.otp", "footer.link"]
  schemaVersion String       @default("1.0.0")
  campaigns    Campaign[]
  messages     Message[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("templates")
}

model Campaign {
  id                String         @id @default(uuid())
  accountId         String
  account           Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  domainId          String
  domain            Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  templateId        String?
  template          Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name              String
  category          EmailCategory  @default(MARKETING)
  brandingMode      BrandingMode   @default(WHITE_LABEL)
  brandType         BrandType      @default(NONE)
  footerHtml        String?        @db.Text // Exact rendered footer (Customer or Platform)
  subject           String
  htmlContent       String         @db.Text
  plainContent      String?        @db.Text
  senderEmail       String
  senderName        String?
  attachments       Json?          // URL-based attachments
  approvalStatus    ApprovalStatus @default(PENDING_ADMIN_APPROVAL)
  rejectionReason   String?
  status            CampaignStatus @default(QUEUED)
  scheduledAt       DateTime?
  totalRecipients   Int            @default(0)
  sentCount         Int            @default(0)
  deliveredCount    Int            @default(0)
  bouncedCount      Int            @default(0)
  failedCount       Int            @default(0)
  costPerEmail      Decimal        @db.Decimal(8, 4)
  totalCostDeducted Decimal        @db.Decimal(12, 4)
  assignedShard     Int            @default(0)
  schemaVersion     String         @default("1.0.0")
  messages          Message[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("campaigns")
}

// Unified Message Table: Used for both 1-to-1 single sends and bulk campaign dispatches
model Message {
  id              String         @id @default(uuid())
  accountId       String
  account         Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  domainId        String
  domain          Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  templateId      String?
  template        Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  category        EmailCategory  @default(TRANSACTIONAL)
  brandingMode    BrandingMode   @default(WHITE_LABEL)
  brandType       BrandType      @default(NONE)
  footerHtml      String?        @db.Text
  recipient       String
  sender          String
  subject         String
  htmlBody        String         @db.Text
  plainBody       String?        @db.Text
  parameters      Json?
  attachments     Json?
  cost            Decimal        @db.Decimal(8, 4)
  status          MessageStatus  @default(PENDING)
  postalMessageId String?
  errorMessage    String?
  assignedShard   Int            @default(0)
  claimedAt       DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  events          MessageEvent[]
  schemaVersion   String         @default("1.0.0")
  createdAt       DateTime       @default(now())

  @@index([accountId, createdAt(sort: Desc)])
  @@index([accountId, status])
  @@index([campaignId, status])
  @@index([assignedShard, status])
  @@index([recipient])
  @@index([postalMessageId])
  @@map("messages")
}

model MessageEvent {
  id            String   @id @default(uuid())
  messageId     String
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  eventType     String   // "ACCEPTED", "SENT", "DELIVERED", "BOUNCED", "HELD", "FAILED"
  details       String?
  postalPayload Json?
  createdAt     DateTime @default(now())

  @@index([messageId, createdAt(sort: Desc)])
  @@map("message_events")
}

model DomainVerification {
  id            String   @id @default(uuid())
  domainId      String
  domain        Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  recordType    String   // "SPF", "DKIM", "MX"
  expectedValue String   @db.Text
  actualValue   String?  @db.Text
  status        String   // "PASS", "FAIL", "DNS_TIMEOUT"
  errorMessage  String?
  checkedAt     DateTime @default(now())

  @@index([domainId, checkedAt(sort: Desc)])
  @@map("domain_verifications")
}

model IdempotencyRecord {
  id           String    @id @default(uuid())
  key          String    @unique
  accountId    String
  endpoint     String
  requestHash  String
  responseBody Json?
  statusCode   Int?
  status       String    @default("PENDING") // "PENDING", "COMPLETED", "FAILED"
  createdAt    DateTime  @default(now())
  expiresAt    DateTime

  @@index([key])
  @@index([accountId, createdAt])
  @@map("idempotency_records")
}

model AuditLog {
  id          String   @id @default(uuid())
  accountId   String?
  action      String
  severity    String   @default("INFO")
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
